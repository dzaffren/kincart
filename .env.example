# Copy to .env.local. pnpm dev, pnpm db:up and pnpm test all read it.

# Postgres connection string: a Neon dev branch, or the local Docker one in README.md
DATABASE_URL=

# developer.paypal.com > Apps & Credentials > Sandbox > your app (US business account, "Save payment methods" ticked)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Secret links: Rose opens /r/<ROSE_LINK_TOKEN>, Sam opens /h/<SAM_LINK_TOKEN>.
# Make each with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
ROSE_LINK_TOKEN=
SAM_LINK_TOKEN=

# Rose's Find: the Claude Console (API keys) and trychannel3.com (free key).
# With either unset, Rose's page shows the fixed list of three items instead.
ANTHROPIC_API_KEY=
CHANNEL3_API_KEY=

# Notifications: make the two keys with pnpm exec web-push generate-vapid-keys.
# VAPID_SUBJECT is the site's https URL or a mailto: address the push services can reach you at.
# With any of the three unset, the Notifications section is hidden and nothing is sent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# pnpm test:e2e only: a saved PayPal (vault id) the e2e charges. See README.md.
PAYPAL_E2E_VAULT_ID=
